"""
Ablation Study Script for Five-Component DRS Encoder

Systematically trains and evaluates valid subsets of the five components under the
architectural dependency constraint:
    `semantic` requires both `temporal` and `participant`.

This yields 19 unique valid configurations across 5 levels (with zero duplicates):
    - single   (4): T, L, P, Txt
    - pairs    (6): T+L, T+P, T+Txt, L+P, L+Txt, P+Txt
    - triplets (5): T+L+P, T+L+Txt, T+P+Txt, L+P+Txt, T+P+S
    - quads    (3): T+L+P+Txt, T+L+P+S, T+P+S+Txt
    - full     (1): T+L+P+S+Txt (all_five)

Generates three complementary analytical views:
    1. 4x4 Accuracy & Synergy matrices across independent base components (T, L, P, Txt)
       plus pairwise prediction complementarity among individual models.
    2. Controlled Marginal Gain of Semantic (Delta-S) across its 4 exact twin comparisons.
    3. Leave-One-Out (LOO) impact relative to the full 5-component model.

Usage:
    # Run all 19 valid configurations
    python -m drsembedding.five.ablation_study ../data/preprocessed_synth.jsonl \
        --val_data ../data/preprocessed_val.jsonl \
        --test_data ../data/preprocessed_dev.jsonl \
        --modes all \
        --temperature 0.1 \
        --epochs 50 \
        --output_dir ./ablation_results

    # Run only specific levels (e.g., singles + pairs, or triplets + quads + full)
    python -m drsembedding.five.ablation_study ../data/preprocessed_synth.jsonl \
        --test_data ../data/preprocessed_dev.jsonl \
        --modes single pairs \
        --seeds 42 123 456 \
        --output_dir ./ablation_single_pairs
"""

import argparse
import csv
import itertools
import json
import random
import time
from pathlib import Path
from typing import Dict, List, Optional, Sequence, Tuple

import numpy as np
import torch
import torch.nn.functional as F
import torch.optim as optim

from drsembedding.data_loader import DRSDataset
from drsembedding.five.five_component_encoder import (
    FiveComponentConfig,
    FiveComponentModel,
    StoryDataProcessor,
)
from drsembedding.five.train_five import (
    FiveComponentTrainer,
    FiveTripletDataset,
    create_datasets,
)

# Canonical ordering prevents duplicate subsets (e.g., text+logical vs logical+text)
COMPONENTS = ['temporal', 'logical', 'participant', 'semantic', 'text']
BASE_COMPONENTS = ['temporal', 'logical', 'participant', 'text']

MODE_TO_SIZE = {
    'single': 1,
    'pairs': 2,
    'triplets': 3,
    'quads': 4,
    'full': 5,
}


def set_seed(seed: int) -> None:
    """Fix all RNG seeds for reproducible comparisons across configurations."""
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def is_valid_subset(components: Sequence[str]) -> bool:
    """
    Enforce architectural dependency:
    SemanticRoleEncoder consumes contextualized node features from both
    TemporalGraphEncoder and ParticipantGraphEncoder.
    """
    if 'semantic' in components:
        return ('temporal' in components) and ('participant' in components)
    return True


def canonical_name(components: Sequence[str]) -> str:
    """Produce a deterministic experiment name from any subset of components."""
    ordered = [c for c in COMPONENTS if c in components]
    if len(ordered) == 1:
        return f"only_{ordered[0]}"
    if len(ordered) == len(COMPONENTS):
        return "all_five"
    return "+".join(ordered)


def build_experiment_grid(modes: Sequence[str]) -> List[Tuple[str, List[str]]]:
    """
    Build the deduplicated list of valid (experiment_name, active_components) tuples
    for the requested ablation levels.
    """
    if 'all' in modes:
        selected_modes = ['single', 'pairs', 'triplets', 'quads', 'full']
    else:
        # Preserve canonical level order and deduplicate requested modes
        selected_modes = [m for m in MODE_TO_SIZE if m in modes]

    experiments: List[Tuple[str, List[str]]] = []
    seen_names = set()

    for mode in selected_modes:
        k = MODE_TO_SIZE[mode]
        for combo in itertools.combinations(COMPONENTS, k):
            if not is_valid_subset(combo):
                continue
            name = canonical_name(combo)
            if name not in seen_names:
                seen_names.add(name)
                experiments.append((name, list(combo)))

    return experiments


def precompute_text_embeddings(
    datasets: Sequence[Optional[FiveTripletDataset]],
    text_model,
    device: str,
    batch_size: int = 64,
) -> None:
    """
    Encode all unique story texts once using the frozen SentenceTransformer and attach
    them as `story_data['text_embedding']` to avoid redundant forward passes.
    """
    if text_model is None:
        return

    unique_texts = set()
    for ds in datasets:
        if ds is None:
            continue
        for item in ds.processed_data:
            for slot in ('anchor', 'story_a', 'story_b'):
                unique_texts.add(item[slot]['text'])

    unique_texts_list = sorted(unique_texts)
    print(f"\nPrecomputing frozen SBERT embeddings for {len(unique_texts_list)} unique texts...")
    start_time = time.time()

    with torch.no_grad():
        all_embs = text_model.encode(
            unique_texts_list,
            batch_size=batch_size,
            convert_to_tensor=True,
            show_progress_bar=False,
        )

    # .clone().detach() exits inference_mode so tensors are safe inside autograd graphs
    text_to_emb = {
        txt: all_embs[i].clone().detach().to(device)
        for i, txt in enumerate(unique_texts_list)
    }

    for ds in datasets:
        if ds is None:
            continue
        for item in ds.processed_data:
            for slot in ('anchor', 'story_a', 'story_b'):
                item[slot]['text_embedding'] = text_to_emb[item[slot]['text']]

    print(f"✓ Precomputed text embeddings in {time.time() - start_time:.1f}s")


@torch.no_grad()
def evaluate_preprocessed_dataset(
    model: FiveComponentModel,
    dataset: FiveTripletDataset,
    device: str,
    n_bootstraps: int = 1000,
    ci: float = 0.95,
    seed: int = 42,
) -> Dict:
    """Evaluate a trained model on a pre-processed FiveTripletDataset with bootstrap CIs."""
    model.eval()
    total_loss = 0.0
    correct_count = 0
    per_example = []

    for item in dataset.processed_data:
        output = model(item['anchor'], item['story_a'], item['story_b'])
        label_val = float(item['label'])
        label_tensor = torch.tensor([label_val], device=device)

        loss = F.binary_cross_entropy_with_logits(output['logits'], label_tensor).item()
        logit = output['logits'].item()
        sim_a = output['sim_a'].item()
        sim_b = output['sim_b'].item()
        cosine_diff = sim_a - sim_b

        pred_a_closer = cosine_diff > 0.0
        label_a_closer = bool(item['label'])
        is_correct = (pred_a_closer == label_a_closer)

        total_loss += loss
        if is_correct:
            correct_count += 1

        per_example.append({
            'idx': item['idx'],
            'logits': logit,
            'cosine_diff': cosine_diff,
            'sim_a': sim_a,
            'sim_b': sim_b,
            'pred_a_closer': pred_a_closer,
            'label_a_closer': label_a_closer,
            'correct': is_correct,
        })

    n = len(per_example)
    if n == 0:
        return {
            'accuracy': 0.0,
            'loss': 0.0,
            'correct': 0,
            'total': 0,
            'ci_lower': 0.0,
            'ci_upper': 0.0,
            'std_err': 0.0,
            'signed_cosine_margin_mean': 0.0,
            'per_example': [],
        }

    accuracy = correct_count / n
    avg_loss = total_loss / n

    # Bootstrap confidence intervals using raw cosine margin (temperature-invariant)
    rng = np.random.default_rng(seed)
    correct_arr = np.array([1.0 if r['correct'] else 0.0 for r in per_example])
    signed_margin_arr = np.array([
        r['cosine_diff'] if r['label_a_closer'] else -r['cosine_diff'] for r in per_example
    ])

    boot_idx = rng.integers(0, n, size=(n_bootstraps, n))
    boot_acc = correct_arr[boot_idx].mean(axis=1)
    boot_margin = signed_margin_arr[boot_idx].mean(axis=1)

    alpha = (1.0 - ci) / 2.0
    lo, hi = alpha * 100.0, (1.0 - alpha) * 100.0

    return {
        'accuracy': accuracy,
        'loss': avg_loss,
        'correct': correct_count,
        'total': n,
        'ci_lower': float(np.percentile(boot_acc, lo)),
        'ci_upper': float(np.percentile(boot_acc, hi)),
        'std_err': float(np.std(boot_acc, ddof=1)),
        'signed_cosine_margin_mean': float(np.mean(boot_margin)),
        'per_example': per_example,
    }


def run_single_experiment(
    exp_name: str,
    active_components: List[str],
    train_dataset: FiveTripletDataset,
    val_dataset: FiveTripletDataset,
    test_dataset: Optional[FiveTripletDataset],
    processor: StoryDataProcessor,
    args: argparse.Namespace,
    seed: int,
    device: str,
    run_dir: Path,
) -> Dict:
    """Train, checkpoint, and evaluate a single ablation configuration."""
    set_seed(seed)
    run_dir.mkdir(parents=True, exist_ok=True)

    text_dim = (
        processor.text_model.get_sentence_embedding_dimension()
        if processor.text_model is not None
        else 384
    )

    config = FiveComponentConfig(
        temporal_dim=args.temporal_dim,
        logical_dim=args.logical_dim,
        participant_dim=args.participant_dim,
        semantic_dim=args.semantic_dim,
        text_dim=text_dim,
        hidden_dim=args.hidden_dim,
        output_dim=args.output_dim,
        dropout=args.dropout,
        text_model_name=args.text_model,
        num_verbnet_classes=len(processor.verbnet_vocab),
        num_predicates=len(processor.predicate_vocab),
        use_temporal=('temporal' in active_components),
        use_logical=('logical' in active_components),
        use_participant=('participant' in active_components),
        use_semantic=('semantic' in active_components),
        use_text=('text' in active_components),
        temperature=args.temperature,
        learnable_temperature=args.learnable_temperature,
    )

    model = FiveComponentModel(
        config,
        device=device,
        shared_text_model=processor.text_model,
    ).to(device)

    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)

    optimizer = optim.AdamW(
        filter(lambda p: p.requires_grad, model.parameters()),
        lr=args.lr,
        weight_decay=args.weight_decay,
    )
    scheduler = optim.lr_scheduler.ReduceLROnPlateau(
        optimizer, mode='min', factor=0.5, patience=5
    )

    trainer = FiveComponentTrainer(
        model=model,
        train_dataset=train_dataset,
        val_dataset=val_dataset,
        optimizer=optimizer,
        scheduler=scheduler,
        device=device,
        checkpoint_dir=str(run_dir),
    )

    start_time = time.time()
    history = trainer.train(
        num_epochs=args.epochs,
        patience=args.patience,
        verbose=args.verbose_epochs,
    )
    train_time = time.time() - start_time

    # Reload best validation checkpoint for final evaluation & weight inspection
    best_ckpt_path = run_dir / 'best_model.pt'
    if best_ckpt_path.exists():
        checkpoint = torch.load(best_ckpt_path, map_location=device)
        model.load_state_dict(checkpoint['model_state_dict'])

    # Save artifacts compatible with evaluate_five.py and generate_embeddings_drs.py
    config_dict = {
        'temporal_dim': config.temporal_dim,
        'logical_dim': config.logical_dim,
        'participant_dim': config.participant_dim,
        'semantic_dim': config.semantic_dim,
        'text_dim': config.text_dim,
        'hidden_dim': config.hidden_dim,
        'output_dim': config.output_dim,
        'dropout': config.dropout,
        'text_model_name': config.text_model_name,
        'num_verbnet_classes': config.num_verbnet_classes,
        'num_predicates': config.num_predicates,
        'num_gnn_layers': config.num_gnn_layers,
        'use_temporal': config.use_temporal,
        'use_logical': config.use_logical,
        'use_participant': config.use_participant,
        'use_semantic': config.use_semantic,
        'use_text': config.use_text,
        'temperature': config.temperature,
        'learnable_temperature': config.learnable_temperature,
    }
    with open(run_dir / 'config.json', 'w', encoding='utf-8') as f:
        json.dump(config_dict, f, indent=2)
    with open(run_dir / 'vocabularies.json', 'w', encoding='utf-8') as f:
        json.dump({
            'verbnet_vocab': processor.verbnet_vocab,
            'predicate_vocab': processor.predicate_vocab,
        }, f)
    with open(run_dir / 'history.json', 'w', encoding='utf-8') as f:
        json.dump(history, f, indent=2)

    # Extract learned softmax weights and final temperature
    learned_weights_tensor = F.softmax(model.component_weights.detach(), dim=0).cpu().tolist()
    learned_weights = {
        comp: float(w)
        for comp, w in zip(model.active_components, learned_weights_tensor)
    }
    final_temperature = float(model.get_temperature().detach().cpu().item())

    val_metrics = evaluate_preprocessed_dataset(
        model, val_dataset, device, n_bootstraps=args.n_bootstraps, seed=seed
    )
    test_metrics = (
        evaluate_preprocessed_dataset(
            model, test_dataset, device, n_bootstraps=args.n_bootstraps, seed=seed
        )
        if test_dataset is not None
        else None
    )

    return {
        'name': exp_name,
        'components': active_components,
        'num_components': len(active_components),
        'seed': seed,
        'trainable_params': trainable_params,
        'best_epoch': trainer.best_epoch + 1,
        'train_time_sec': round(train_time, 2),
        'final_temperature': final_temperature,
        'learned_weights': learned_weights,
        'val_acc': val_metrics['accuracy'],
        'val_loss': val_metrics['loss'],
        'val_ci': [val_metrics['ci_lower'], val_metrics['ci_upper']],
        'val_margin': val_metrics['signed_cosine_margin_mean'],
        'val_per_example': val_metrics['per_example'],
        'test_acc': test_metrics['accuracy'] if test_metrics else None,
        'test_loss': test_metrics['loss'] if test_metrics else None,
        'test_ci': [test_metrics['ci_lower'], test_metrics['ci_upper']] if test_metrics else None,
        'test_margin': test_metrics['signed_cosine_margin_mean'] if test_metrics else None,
        'test_per_example': test_metrics['per_example'] if test_metrics else None,
    }


def aggregate_across_seeds(all_runs: List[Dict]) -> Dict[str, Dict]:
    """Aggregate metrics across random seeds for each experiment configuration."""
    grouped: Dict[str, List[Dict]] = {}
    for run in all_runs:
        grouped.setdefault(run['name'], []).append(run)

    summary = {}
    for name, runs in grouped.items():
        val_accs = [r['val_acc'] for r in runs]
        test_accs = [r['test_acc'] for r in runs if r['test_acc'] is not None]
        temps = [r['final_temperature'] for r in runs]

        avg_weights = {
            comp: float(np.mean([r['learned_weights'][comp] for r in runs]))
            for comp in runs[0]['components']
        }

        summary[name] = {
            'name': name,
            'components': runs[0]['components'],
            'num_components': runs[0]['num_components'],
            'trainable_params': runs[0]['trainable_params'],
            'num_seeds': len(runs),
            'final_temperature_mean': float(np.mean(temps)),
            'val_acc_mean': float(np.mean(val_accs)),
            'val_acc_std': float(np.std(val_accs, ddof=1)) if len(val_accs) > 1 else 0.0,
            'val_ci_first_seed': runs[0]['val_ci'],
            'val_margin_mean': float(np.mean([r['val_margin'] for r in runs])),
            'test_acc_mean': float(np.mean(test_accs)) if test_accs else None,
            'test_acc_std': (
                float(np.std(test_accs, ddof=1)) if len(test_accs) > 1 else 0.0
            ) if test_accs else None,
            'test_ci_first_seed': runs[0]['test_ci'],
            'test_margin_mean': (
                float(np.mean([r['test_margin'] for r in runs if r['test_margin'] is not None]))
                if test_accs else None
            ),
            'learned_weights': avg_weights,
            'runs': runs,
        }

    return summary


# ============================================================
# ANALYTICAL VIEWS (VIEW 1, VIEW 2, VIEW 3)
# ============================================================

def compute_base_matrices(summary: Dict[str, Dict], metric_key: str) -> Tuple[np.ndarray, np.ndarray]:
    """
    View 1: 4x4 Accuracy and Synergy matrices over the 4 independent base components
    (temporal, logical, participant, text).
        - Diagonal: single-component accuracy
        - Off-diagonal: pair accuracy
        - Synergy(A, B) = Acc(A + B) - max(Acc(A), Acc(B))
    """
    n = len(BASE_COMPONENTS)
    acc_matrix = np.full((n, n), np.nan)
    synergy_matrix = np.full((n, n), np.nan)

    for i, comp in enumerate(BASE_COMPONENTS):
        key = canonical_name([comp])
        if key in summary and summary[key][metric_key] is not None:
            acc_matrix[i, i] = summary[key][metric_key]
            synergy_matrix[i, i] = 0.0

    for i, comp_a in enumerate(BASE_COMPONENTS):
        for j, comp_b in enumerate(BASE_COMPONENTS):
            if i >= j:
                continue
            key = canonical_name([comp_a, comp_b])
            if key in summary and summary[key][metric_key] is not None:
                pair_acc = summary[key][metric_key]
                acc_matrix[i, j] = pair_acc
                acc_matrix[j, i] = pair_acc

                if not np.isnan(acc_matrix[i, i]) and not np.isnan(acc_matrix[j, j]):
                    synergy = pair_acc - max(acc_matrix[i, i], acc_matrix[j, j])
                    synergy_matrix[i, j] = synergy
                    synergy_matrix[j, i] = synergy

    return acc_matrix, synergy_matrix


def compute_base_complementarity(summary: Dict[str, Dict], use_test: bool) -> List[Dict]:
    """
    View 1b: Pairwise agreement and error-rescue complementarity across the 4
    single-component models (computed on the first seed).
    """
    ex_key = 'test_per_example' if use_test else 'val_per_example'
    rows = []

    for comp_a, comp_b in itertools.combinations(BASE_COMPONENTS, 2):
        key_a = canonical_name([comp_a])
        key_b = canonical_name([comp_b])
        if key_a not in summary or key_b not in summary:
            continue

        ex_a = summary[key_a]['runs'][0].get(ex_key)
        ex_b = summary[key_b]['runs'][0].get(ex_key)
        if not ex_a or not ex_b:
            continue

        n = len(ex_a)
        agree = sum(1 for a, b in zip(ex_a, ex_b) if a['pred_a_closer'] == b['pred_a_closer'])
        both_correct = sum(1 for a, b in zip(ex_a, ex_b) if a['correct'] and b['correct'])
        only_a_correct = sum(1 for a, b in zip(ex_a, ex_b) if a['correct'] and not b['correct'])
        only_b_correct = sum(1 for a, b in zip(ex_a, ex_b) if not a['correct'] and b['correct'])
        oracle_correct = both_correct + only_a_correct + only_b_correct

        errors_a = sum(1 for a in ex_a if not a['correct'])
        errors_b = sum(1 for b in ex_b if not b['correct'])

        rows.append({
            'pair': f"{comp_a} vs {comp_b}",
            'agreement_rate': agree / n,
            'a_rescues_b': only_a_correct / errors_b if errors_b > 0 else 0.0,
            'b_rescues_a': only_b_correct / errors_a if errors_a > 0 else 0.0,
            'oracle_acc': oracle_correct / n,
        })

    return rows


def compute_semantic_marginal_gains(summary: Dict[str, Dict], metric_key: str) -> List[Dict]:
    """
    View 2: Controlled Marginal Gain of the Semantic component (Delta-S).
    Compares every valid model containing `semantic` against its exact twin without `semantic`.
    """
    twin_contexts = [
        (['temporal', 'participant'], 'Base graphs only (T + P)'),
        (['temporal', 'logical', 'participant'], 'With Logical (T + L + P)'),
        (['temporal', 'participant', 'text'], 'With Text (T + P + Txt)'),
        (['temporal', 'logical', 'participant', 'text'], 'Full model minus Semantic (T + L + P + Txt)'),
    ]

    rows = []
    for base_comps, context_label in twin_contexts:
        without_key = canonical_name(base_comps)
        with_key = canonical_name(base_comps + ['semantic'])

        if without_key in summary and with_key in summary:
            acc_without = summary[without_key][metric_key]
            acc_with = summary[with_key][metric_key]
            if acc_without is not None and acc_with is not None:
                rows.append({
                    'context': context_label,
                    'without_semantic': without_key,
                    'with_semantic': with_key,
                    'acc_without': acc_without,
                    'acc_with': acc_with,
                    'delta_semantic': acc_with - acc_without,
                    'semantic_learned_weight': summary[with_key]['learned_weights'].get('semantic', 0.0),
                })

    return rows


def compute_leave_one_out(summary: Dict[str, Dict], metric_key: str) -> List[Dict]:
    """
    View 3: Leave-One-Out (LOO) drop from the full 5-component model.
    Because `semantic` depends on `temporal` and `participant`, removing either of those
    structurally removes `semantic` as well (explicitly noted in the table).
    """
    full_key = canonical_name(COMPONENTS)
    if full_key not in summary or summary[full_key][metric_key] is None:
        return []

    full_acc = summary[full_key][metric_key]
    ablations = [
        ('semantic', ['temporal', 'logical', 'participant', 'text'], 'Direct removal (-semantic)'),
        ('logical', ['temporal', 'participant', 'semantic', 'text'], 'Direct removal (-logical)'),
        ('text', ['temporal', 'logical', 'participant', 'semantic'], 'Direct removal (-text)'),
        ('temporal', ['logical', 'participant', 'text'], 'Structural removal (-temporal, -semantic)'),
        ('participant', ['temporal', 'logical', 'text'], 'Structural removal (-participant, -semantic)'),
    ]

    rows = []
    for removed_comp, remaining_comps, removal_type in ablations:
        rem_key = canonical_name(remaining_comps)
        if rem_key in summary and summary[rem_key][metric_key] is not None:
            rem_acc = summary[rem_key][metric_key]
            rows.append({
                'removed': removed_comp,
                'remaining_model': rem_key,
                'removal_type': removal_type,
                'full_acc': full_acc,
                'ablated_acc': rem_acc,
                'delta_vs_full': rem_acc - full_acc,
            })

    return rows


