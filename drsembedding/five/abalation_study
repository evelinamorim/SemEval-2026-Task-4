def save_matrix_csv(matrix: np.ndarray, labels: Sequence[str], path: Path) -> None:
    """Export a labeled square matrix to CSV (values in percentage points)."""
    with open(path, 'w', newline='', encoding='utf-8') as f:
        writer = csv.writer(f)
        writer.writerow(['component'] + list(labels))
        for i, label in enumerate(labels):
            row = [label] + [
                f"{matrix[i, j] * 100:.2f}" if not np.isnan(matrix[i, j]) else ""
                for j in range(len(labels))
            ]
            writer.writerow(row)


def save_heatmaps(
    acc_matrix: np.ndarray,
    synergy_matrix: np.ndarray,
    semantic_gains: List[Dict],
    output_path: Path,
    split_label: str,
) -> None:
    """Save 4x4 Accuracy/Synergy heatmaps and Semantic Marginal Gain bar chart."""
    try:
        import matplotlib.pyplot as plt
    except ImportError:
        print("Note: matplotlib is not installed; skipping PNG plot generation.")
        return

    num_panels = 3 if semantic_gains else 2
    fig, axes = plt.subplots(1, num_panels, figsize=(6 * num_panels, 5.2))
    if num_panels == 2:
        axes = list(axes)

    # Panel 1: 4x4 Base Accuracy Matrix
    im1 = axes[0].imshow(acc_matrix * 100, cmap='YlGnBu', aspect='auto')
    axes[0].set_title(f'Base Components Accuracy ({split_label}, %)\nDiagonal = Single | Off-diagonal = Pairs')
    axes[0].set_xticks(range(len(BASE_COMPONENTS)))
    axes[0].set_yticks(range(len(BASE_COMPONENTS)))
    axes[0].set_xticklabels(BASE_COMPONENTS, rotation=25, ha='right')
    axes[0].set_yticklabels(BASE_COMPONENTS)
    for i in range(len(BASE_COMPONENTS)):
        for j in range(len(BASE_COMPONENTS)):
            if not np.isnan(acc_matrix[i, j]):
                axes[0].text(j, i, f"{acc_matrix[i, j] * 100:.1f}%", ha='center', va='center', color='black')
    fig.colorbar(im1, ax=axes[0], fraction=0.046, pad=0.04)

    # Panel 2: 4x4 Base Synergy Matrix
    valid_syn = synergy_matrix[~np.isnan(synergy_matrix)] * 100
    vmax = max(float(np.max(np.abs(valid_syn))) if valid_syn.size > 0 else 1.0, 1.0)
    im2 = axes[1].imshow(synergy_matrix * 100, cmap='RdYlGn', vmin=-vmax, vmax=vmax, aspect='auto')
    axes[1].set_title(f'Pairwise Synergy ({split_label}, pp)\nAcc(A+B) - max(Acc(A), Acc(B))')
    axes[1].set_xticks(range(len(BASE_COMPONENTS)))
    axes[1].set_yticks(range(len(BASE_COMPONENTS)))
    axes[1].set_xticklabels(BASE_COMPONENTS, rotation=25, ha='right')
    axes[1].set_yticklabels(BASE_COMPONENTS)
    for i in range(len(BASE_COMPONENTS)):
        for j in range(len(BASE_COMPONENTS)):
            if not np.isnan(synergy_matrix[i, j]):
                val = synergy_matrix[i, j] * 100
                sign = '+' if val > 0 else ''
                axes[1].text(j, i, f"{sign}{val:.1f}", ha='center', va='center', color='black')
    fig.colorbar(im2, ax=axes[1], fraction=0.046, pad=0.04)

    # Panel 3: Controlled Marginal Gain of Semantic (Delta-S)
    if semantic_gains:
        labels = [row['without_semantic'] for row in semantic_gains]
        deltas = [row['delta_semantic'] * 100 for row in semantic_gains]
        colors = ['#2ca02c' if d >= 0 else '#d62728' for d in deltas]

        y_pos = np.arange(len(labels))
        axes[2].barh(y_pos, deltas, color=colors, alpha=0.85)
        axes[2].axvline(0.0, color='black', linewidth=0.9)
        axes[2].set_yticks(y_pos)
        axes[2].set_yticklabels(labels, fontsize=9)
        axes[2].set_xlabel('Accuracy Delta (percentage points)')
        axes[2].set_title(f'Controlled Semantic Gain ({split_label})\n(+semantic vs exact twin)')
        for idx, val in enumerate(deltas):
            ha = 'left' if val >= 0 else 'right'
            offset = 0.15 if val >= 0 else -0.15
            axes[2].text(val + offset, idx, f"{val:+.2f}pp", va='center', ha=ha, fontsize=9)

    plt.tight_layout()
    plt.savefig(output_path, dpi=200)
    plt.close(fig)
    print(f"✓ Saved ablation plots to: {output_path}")


def print_report(
    summary: Dict[str, Dict],
    acc_matrix: np.ndarray,
    synergy_matrix: np.ndarray,
    complementarity: List[Dict],
    semantic_gains: List[Dict],
    loo_rows: List[Dict],
    metric_key: str,
    split_label: str,
) -> None:
    """Print a structured summary of all three analytical views to stdout."""
    print("\n" + "=" * 96)
    print(f"ABLATION STUDY LEADERBOARD ({split_label.upper()})")
    print("=" * 96)

    ranked = sorted(
        summary.values(),
        key=lambda x: x[metric_key] if x[metric_key] is not None else -1.0,
        reverse=True,
    )

    print(f"{'Experiment':<34} {'#C':>3} {'Val Acc':>10} {'Test Acc':>10} {'Temp':>6}   {'Learned Weights'}")
    print("-" * 96)
    for item in ranked:
        val_str = f"{item['val_acc_mean'] * 100:.2f}%"
        test_str = f"{item['test_acc_mean'] * 100:.2f}%" if item['test_acc_mean'] is not None else "N/A"
        temp_str = f"{item['final_temperature_mean']:.3f}"
        w_str = ", ".join(f"{k[:4]}={v:.2f}" for k, v in item['learned_weights'].items())
        print(f"{item['name']:<34} {item['num_components']:>3} {val_str:>10} {test_str:>10} {temp_str:>6}   {w_str}")

    # View 1: 4x4 Base Matrices
    if not np.all(np.isnan(acc_matrix)):
        print("\n" + "-" * 96)
        print(f"VIEW 1A: 4x4 BASE ACCURACY MATRIX ({split_label}, %) — Diagonal: Single | Off-diagonal: Pairs")
        print("-" * 96)
        header = f"{'':<14}" + "".join(f"{c:>14}" for c in BASE_COMPONENTS)
        print(header)
        for i, comp in enumerate(BASE_COMPONENTS):
            row = f"{comp:<14}" + "".join(
                f"{acc_matrix[i, j] * 100:>13.2f}%" if not np.isnan(acc_matrix[i, j]) else f"{'--':>14}"
                for j in range(len(BASE_COMPONENTS))
            )
            print(row)

        print("\n" + "-" * 96)
        print(f"VIEW 1B: 4x4 BASE SYNERGY MATRIX ({split_label}, pp) — Acc(A+B) - max(Acc(A), Acc(B))")
        print("-" * 96)
        print(header)
        for i, comp in enumerate(BASE_COMPONENTS):
            cells = []
            for j in range(len(BASE_COMPONENTS)):
                if np.isnan(synergy_matrix[i, j]):
                    cells.append(f"{'--':>14}")
                elif i == j:
                    cells.append(f"{'0.00':>14}")
                else:
                    cells.append(f"{synergy_matrix[i, j] * 100:>+13.2f}%")
            print(f"{comp:<14}" + "".join(cells))

    if complementarity:
        print("\n" + "-" * 96)
        print(f"VIEW 1C: INDIVIDUAL MODEL COMPLEMENTARITY ({split_label})")
        print("-" * 96)
        print(f"{'Pair (A vs B)':<28} {'Agreement':>11} {'A rescues B':>13} {'B rescues A':>13} {'Oracle Acc':>12}")
        for row in complementarity:
            print(
                f"{row['pair']:<28} "
                f"{row['agreement_rate'] * 100:>10.2f}% "
                f"{row['a_rescues_b'] * 100:>12.2f}% "
                f"{row['b_rescues_a'] * 100:>12.2f}% "
                f"{row['oracle_acc'] * 100:>11.2f}%"
            )

    # View 2: Controlled Semantic Gain
    if semantic_gains:
        print("\n" + "-" * 96)
        print(f"VIEW 2: CONTROLLED MARGINAL GAIN OF SEMANTIC ({split_label})")
        print("-" * 96)
        print(f"{'Baseline Twin (without S)':<36} {'No S':>9} {'With S':>9} {'Delta S':>10} {'S Weight':>10}")
        for row in semantic_gains:
            print(
                f"{row['without_semantic']:<36} "
                f"{row['acc_without'] * 100:>8.2f}% "
                f"{row['acc_with'] * 100:>8.2f}% "
                f"{row['delta_semantic'] * 100:>+9.2f}% "
                f"{row['semantic_learned_weight']:>10.3f}"
            )

    # View 3: Leave-One-Out from Full Model
    if loo_rows:
        print("\n" + "-" * 96)
        print(f"VIEW 3: LEAVE-ONE-OUT DROP FROM FULL MODEL ({split_label})")
        print("-" * 96)
        print(f"{'Removed':<14} {'Ablated Model':<34} {'Ablated Acc':>12} {'Delta vs Full':>14}   {'Type'}")
        for row in loo_rows:
            print(
                f"{row['removed']:<14} "
                f"{row['remaining_model']:<34} "
                f"{row['ablated_acc'] * 100:>11.2f}% "
                f"{row['delta_vs_full'] * 100:>+13.2f}%   "
                f"{row['removal_type']}"
            )


def main() -> None:
    parser = argparse.ArgumentParser(
        description='Valid 19-configuration ablation study for FiveComponentModel'
    )
    parser.add_argument('train_data', type=str, help='Path to preprocessed training JSONL')
    parser.add_argument('--val_data', type=str, default=None, help='Optional separate validation JSONL')
    parser.add_argument('--test_data', type=str, default=None, help='Optional test/dev JSONL for final evaluation')
    parser.add_argument('--val_split', type=float, default=0.1, help='Validation split ratio if --val_data is omitted')
    parser.add_argument('--output_dir', type=str, default='./ablation_results', help='Directory for checkpoints & reports')

    # Ablation levels & seeds
    parser.add_argument(
        '--modes',
        nargs='+',
        choices=['single', 'pairs', 'triplets', 'quads', 'full', 'all'],
        default=['all'],
        help='Ablation levels to run (default: all 19 valid configurations)',
    )
    parser.add_argument(
        '--seeds',
        nargs='+',
        type=int,
        default=[42],
        help='One or more random seeds to average over (e.g., --seeds 42 123 456)',
    )

    # Training hyperparameters
    parser.add_argument('--epochs', type=int, default=50, help='Maximum training epochs')
    parser.add_argument('--lr', type=float, default=1e-3, help='Learning rate')
    parser.add_argument('--weight_decay', type=float, default=0.01, help='AdamW weight decay')
    parser.add_argument('--dropout', type=float, default=0.1, help='Dropout probability')
    parser.add_argument('--patience', type=int, default=10, help='Early stopping patience')

    # Temperature scaling
    parser.add_argument(
        '--temperature',
        type=float,
        default=0.1,
        help='Cosine similarity logit temperature (default: 0.1; use 1.0 for unscaled cosine diff)',
    )
    parser.add_argument(
        '--learnable_temperature',
        action='store_true',
        help='Make logit temperature a learnable parameter initialized to --temperature',
    )

    # Architecture dimensions
    parser.add_argument('--temporal_dim', type=int, default=64)
    parser.add_argument('--logical_dim', type=int, default=64)
    parser.add_argument('--participant_dim', type=int, default=64)
    parser.add_argument('--semantic_dim', type=int, default=64)
    parser.add_argument('--hidden_dim', type=int, default=128)
    parser.add_argument('--output_dim', type=int, default=128)
    parser.add_argument('--text_model', type=str, default='all-MiniLM-L6-v2')

    # Evaluation & runtime
    parser.add_argument('--n_bootstraps', type=int, default=1000, help='Bootstrap resamples for CIs')
    parser.add_argument('--device', type=str, default='auto', help='cuda, cpu, or auto')
    parser.add_argument('--verbose_epochs', action='store_true', help='Print per-epoch training logs')

    args = parser.parse_args()

    device = ('cuda' if torch.cuda.is_available() else 'cpu') if args.device == 'auto' else args.device
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    experiments = build_experiment_grid(args.modes)

    print("\n" + "=" * 80)
    print("FIVE-COMPONENT DRS ENCODER — ABLATION STUDY")
    print("=" * 80)
    print(f"Device:         {device}")
    print(f"Modes:          {args.modes}")
    print(f"Valid models:   {len(experiments)} unique configurations")
    print(f"Seeds:          {args.seeds} ({len(experiments) * len(args.seeds)} total runs)")
    print(f"Temperature:    {args.temperature} ({'learnable' if args.learnable_temperature else 'fixed'})")
    print(f"Output dir:     {output_dir}")
    print("\nScheduled configurations:")
    for idx, (exp_name, comps) in enumerate(experiments, start=1):
        print(f"  {idx:2d}. {exp_name:<34} -> {comps}")

    # 1. Build vocabularies and preprocess datasets once
    drs_train = DRSDataset(args.train_data)
    processor = StoryDataProcessor(drs_train, text_model_name=args.text_model)

    train_dataset, val_dataset = create_datasets(
        args.train_data,
        processor,
        val_jsonl_path=args.val_data,
        val_split=args.val_split,
        seed=args.seeds[0],
        device=device,
    )

    test_dataset = None
    if args.test_data is not None:
        print(f"\nPre-processing test dataset: {args.test_data}")
        drs_test = DRSDataset(args.test_data)
        test_dataset = FiveTripletDataset(drs_test, processor, device=device)

    # 2. Precompute frozen SBERT embeddings once for all stories
    precompute_text_embeddings(
        [train_dataset, val_dataset, test_dataset],
        processor.text_model,
        device=device,
    )

    # 3. Run all scheduled experiments
    all_runs = []
    total_runs = len(experiments) * len(args.seeds)
    run_counter = 0

    for exp_name, active_comps in experiments:
        for seed in args.seeds:
            run_counter += 1
            print(f"\n[{run_counter}/{total_runs}] Running {exp_name} (seed={seed}) -> {active_comps}")

            run_folder_name = f"{exp_name}_seed{seed}" if len(args.seeds) > 1 else exp_name
            run_subdir = output_dir / 'runs' / run_folder_name

            result = run_single_experiment(
                exp_name=exp_name,
                active_components=active_comps,
                train_dataset=train_dataset,
                val_dataset=val_dataset,
                test_dataset=test_dataset,
                processor=processor,
                args=args,
                seed=seed,
                device=device,
                run_dir=run_subdir,
            )
            all_runs.append(result)

            msg = f"  ✓ {exp_name} | Val Acc: {result['val_acc'] * 100:.2f}%"
            if result['test_acc'] is not None:
                msg += f" | Test Acc: {result['test_acc'] * 100:.2f}%"
            msg += (
                f" | Temp: {result['final_temperature']:.3f}"
                f" | Weights: { {k: round(v, 3) for k, v in result['learned_weights'].items()} }"
            )
            print(msg)

    # 4. Aggregate across seeds & compute the three analytical views
    summary = aggregate_across_seeds(all_runs)
    use_test = test_dataset is not None
    metric_key = 'test_acc_mean' if use_test else 'val_acc_mean'
    split_label = 'Test' if use_test else 'Validation'

    acc_matrix, synergy_matrix = compute_base_matrices(summary, metric_key)
    complementarity = compute_base_complementarity(summary, use_test=use_test)
    semantic_gains = compute_semantic_marginal_gains(summary, metric_key)
    loo_rows = compute_leave_one_out(summary, metric_key)

    # 5. Print console report
    print_report(
        summary=summary,
        acc_matrix=acc_matrix,
        synergy_matrix=synergy_matrix,
        complementarity=complementarity,
        semantic_gains=semantic_gains,
        loo_rows=loo_rows,
        metric_key=metric_key,
        split_label=split_label,
    )

    # 6. Export CSVs, JSON, and PNG plots
    with open(output_dir / 'ablation_summary.csv', 'w', newline='', encoding='utf-8') as f:
        writer = csv.writer(f)
        writer.writerow([
            'experiment', 'components', 'num_components', 'trainable_params',
            'final_temperature_mean', 'val_acc_mean', 'val_acc_std',
            'test_acc_mean', 'test_acc_std', 'learned_weights',
        ])
        for item in sorted(summary.values(), key=lambda x: x[metric_key] or -1.0, reverse=True):
            writer.writerow([
                item['name'],
                '+'.join(item['components']),
                item['num_components'],
                item['trainable_params'],
                f"{item['final_temperature_mean']:.4f}",
                f"{item['val_acc_mean']:.6f}",
                f"{item['val_acc_std']:.6f}",
                f"{item['test_acc_mean']:.6f}" if item['test_acc_mean'] is not None else "",
                f"{item['test_acc_std']:.6f}" if item['test_acc_std'] is not None else "",
                json.dumps(item['learned_weights']),
            ])

    save_matrix_csv(acc_matrix, BASE_COMPONENTS, output_dir / 'base_accuracy_matrix.csv')
    save_matrix_csv(synergy_matrix, BASE_COMPONENTS, output_dir / 'base_synergy_matrix.csv')

    if semantic_gains:
        with open(output_dir / 'semantic_marginal_gain.csv', 'w', newline='', encoding='utf-8') as f:
            writer = csv.DictWriter(f, fieldnames=list(semantic_gains[0].keys()))
            writer.writeheader()
            writer.writerows(semantic_gains)

    if loo_rows:
        with open(output_dir / 'leave_one_out.csv', 'w', newline='', encoding='utf-8') as f:
            writer = csv.DictWriter(f, fieldnames=list(loo_rows[0].keys()))
            writer.writeheader()
            writer.writerows(loo_rows)

    save_heatmaps(
        acc_matrix=acc_matrix,
        synergy_matrix=synergy_matrix,
        semantic_gains=semantic_gains,
        output_path=output_dir / 'ablation_plots.png',
        split_label=split_label,
    )

    json_payload = {
        'split_evaluated': split_label,
        'components': COMPONENTS,
        'base_components': BASE_COMPONENTS,
        'seeds': args.seeds,
        'temperature_init': args.temperature,
        'learnable_temperature': args.learnable_temperature,
        'base_accuracy_matrix': np.where(np.isnan(acc_matrix), None, acc_matrix).tolist(),
        'base_synergy_matrix': np.where(np.isnan(synergy_matrix), None, synergy_matrix).tolist(),
        'individual_complementarity': complementarity,
        'semantic_marginal_gains': semantic_gains,
        'leave_one_out': loo_rows,
        'summary': {
            k: {sk: sv for sk, sv in v.items() if sk != 'runs'}
            for k, v in summary.items()
        },
    }
    with open(output_dir / 'ablation_results.json', 'w', encoding='utf-8') as f:
        json.dump(json_payload, f, indent=2, ensure_ascii=False)

    print(f"\n✓ All ablation outputs saved to: {output_dir.resolve()}")


if __name__ == "__main__":
    main()